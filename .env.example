# Copy to .env for Docker Compose. Never commit the populated file.
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:////data/forgeguard.db
MAX_REPAIR_CYCLES=2
WORKSPACE_ROOT=/workspace
WORKSPACE_RETENTION_HOURS=0
ALLOWED_REPOS=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGIN_REGEX=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
OPENAI_API_KEY=
GROQ_API_KEY=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_DEVELOPER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_TEAM=
SESSION_SECRET=
