# Precedence: process environment > this .env file > safe application defaults.
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
OPENAI_API_KEY=
GROQ_API_KEY=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_DEVELOPER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_TEAM=
SESSION_SECRET=

DATABASE_URL=sqlite+aiosqlite:///./forgeguard.db
MAX_REPAIR_CYCLES=2
WORKSPACE_ROOT=../.forgeguard-work
WORKSPACE_RETENTION_HOURS=0
ALLOWED_REPOS=
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGIN_REGEX=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEMO_REPO_PATH=../demo-repo

OPENAI_MODEL=gpt-4o
GROQ_MODEL=llama-3.3-70b-versatile
ENGINEER_TIMEOUT_SECONDS=60
REVIEWER_TIMEOUT_SECONDS=30
COMMAND_TIMEOUT_SECONDS=120
